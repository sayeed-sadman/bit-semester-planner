{
  "name": "BIT Semester Planner",
  "image": "mcr.microsoft.com/devcontainers/java:21",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "postCreateCommand": "cd /workspaces/bit-semester-planner && chmod +x mvnw 2>/dev/null || true && ./mvnw dependency:resolve -q && cd frontend && npm install",
  "postStartCommand": "bash /workspaces/bit-semester-planner/.devcontainer/start.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Backend API", "onAutoForward": "notify" },
    "5173": { "label": "Frontend", "onAutoForward": "openBrowserOnce" }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "task.allowAutomaticTasks": "on"
      }
    }
  }
}
