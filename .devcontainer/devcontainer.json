{
  "name": "BIT Semester Planner",
  "image": "mcr.microsoft.com/devcontainers/java:21",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "postStartCommand": "bash /workspaces/bit-semester-planner/start.sh",
  "forwardPorts": [8080, 5173],
  "portsAttributes": {
    "8080": { "label": "Backend API", "onAutoForward": "notify" },
    "5173": { "label": "Frontend", "onAutoForward": "openBrowser" }
  }
}
